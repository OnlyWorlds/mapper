/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(), camera=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: noindex
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/index.html
  Cache-Control: no-cache

# Sign in with OnlyWorlds returns to /signin/callback with a code in the address: never cached,
# never sent on as a Referer. The host serves the path from the real file signin/callback.html
# (the mapper's own page); the other two spellings are the host's redirects to it.
/signin/callback
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  Cache-Control: no-store

/signin/callback/
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  Cache-Control: no-store

/signin/callback.html
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  Cache-Control: no-store

/assets/*
  Cache-Control: public, max-age=31536000, immutable
