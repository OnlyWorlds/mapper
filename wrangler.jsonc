{
  "name": "maps",
  "compatibility_date": "2026-11-13",
  "account_id": "fbc0b25eec19b417399cf4da4166f7fb",
  "workers_dev": false,
  "preview_urls": false,
  // No single-page fallback: an unknown path is the 404 page. Sign in with OnlyWorlds returns to
  // /signin/callback, which auto-trailing-slash serves from the real file dist/signin/callback.html
  // (the mapper's own page, built from signin/callback.html).
  "assets": { "directory": "./dist", "not_found_handling": "404-page", "html_handling": "auto-trailing-slash" },
  "routes": [ { "pattern": "maps.onlyworlds.com", "custom_domain": true } ]
}
